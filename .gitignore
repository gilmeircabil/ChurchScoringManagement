# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*

# --- Secrets and signing material: never commit these ---
*.jks
*.keystore
*.p8
*.p12
*.pem
*.cer
*.crt
*.key
*.mobileprovision
*.provisionprofile
*.ipa
*.aab
google-services.json
GoogleService-Info.plist
PlayStoreServiceAccountKey.json
secrets.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# local env files
# `.env.example` stays tracked so the required variable names are documented.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# local EAS / build output
eas-build-*/
*.aab
*.apk
*.ipa

# generated native folders (Continuous Native Generation)
/ios
/android
