{
  "expo": {
    "name": "Quiz Manager",
    "slug": "quiz-score-manager",
    "description": "Offline cross-platform app for managing weekly quiz rounds, players, manual group assignments, individual scores, cumulative reports, and round history.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "quizscore",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "primaryColor": "#4F46E5",
    "backgroundColor": "#F8FAFC",
    "platforms": ["android", "ios", "web"],
    "ios": {
      "bundleIdentifier": "com.gilmierdev.quizscore",
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "android": {
      "package": "com.gilmierdev.quizscore",
      "adaptiveIcon": {
        "backgroundColor": "#090F24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MANAGE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-document-picker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040711",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
